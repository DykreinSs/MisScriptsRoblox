local Core = {}
function Core.number(x)
    return type(x) == "number" and x == x and x > -math.huge and x < math.huge
end
function Core.normalize(raw)
    if type(raw) ~= "table" or type(raw.id) ~= "string" or raw.id == "" then return nil end
    if not Core.number(raw.playing) or not Core.number(raw.maxPlayers) then return nil end
    if raw.playing < 0 or raw.playing % 1 ~= 0 or raw.maxPlayers <= 0 or raw.maxPlayers % 1 ~= 0 then return nil end
    local ping = Core.number(raw.ping) and raw.ping > 0 and raw.ping or nil
    return {id=raw.id, playing=raw.playing, maxPlayers=raw.maxPlayers, ping=ping}
end
function Core.accepts(server, prefs, currentId, visited, now, ttl)
    if server.id == currentId or server.playing >= server.maxPlayers then return false end
    local seen = visited[server.id]
    if Core.number(seen) and now - seen < ttl then return false end
    if prefs.players == "quiet" and server.playing > 1 then return false end
    if prefs.ping == "under150" and (not server.ping or server.ping > 150) then return false end
    return true
end
function Core.candidates(servers, prefs, currentId, visited, now, ttl)
    local out, seen = {}, {}
    for _, raw in ipairs(servers) do
        local server = Core.normalize(raw)
        if server and not seen[server.id] and Core.accepts(server,prefs,currentId,visited,now,ttl) then
            seen[server.id] = true
            out[#out+1] = server
        end
    end
    table.sort(out, function(a,b)
        if a.playing ~= b.playing then return a.playing < b.playing end
        if prefs.ping ~= "any" and (a.ping or math.huge) ~= (b.ping or math.huge) then
            return (a.ping or math.huge) < (b.ping or math.huge)
        end
        return a.id < b.id
    end)
    return out
end
function Core.adminCandidates(servers, pingMode, currentId, visited, now, ttl, clock, freshSeconds)
    local out,seen={},{}
    local filter={players="quiet",ping=pingMode}
    for _,raw in ipairs(servers) do
        local server=Core.normalize(raw)
        local received=type(raw)=="table" and raw.observedAt
        if server and not seen[server.id] and Core.number(received)
            and clock>=received and clock-received<=freshSeconds
            and Core.accepts(server,filter,currentId,visited,now,ttl) then
            seen[server.id]=true; out[#out+1]=server
        end
    end
    return out
end
function Core.pickAdmin(pool,pingMode,roll)
    if #pool==0 then return nil end
    -- Probabilidad suave: ningun candidato valido queda descartado por su posicion.
    -- "best" favorece moderadamente ping bajo sin elegir siempre el mismo servidor.
    local weights,total={},0
    for i,server in ipairs(pool) do
        local weight=1
        if pingMode=="best" then
            weight=server.ping and math.max(0.5,math.min(2,150/server.ping)) or 0.5
        end
        weights[i]=weight; total=total+weight
    end
    local threshold=math.max(0,math.min(0.999999999,roll))*total
    for i,server in ipairs(pool) do
        threshold=threshold-weights[i]
        if threshold<0 then return server end
    end
    return pool[#pool]
end
function Core.autoSatisfied(prefs,count,maxPlayers,ping)
    local quiet=prefs.autoMode=="admin" or prefs.players=="quiet"
    -- El usuario ya esta incluido: 2 personas equivale a 1 acompanante.
    if quiet and count>2 then return false end
    if not quiet and maxPlayers>0 and count>=maxPlayers then return false end
    if prefs.ping=="under150" then
        if not Core.number(ping) or ping<=0 then return nil end
        if ping>150 then return false end
    end
    return true
end
function Core.duration(seconds)
    seconds = math.max(0, math.floor(seconds))
    local days = math.floor(seconds / 86400)
    local text = string.format("%02d:%02d:%02d",math.floor(seconds/3600)%24,math.floor(seconds/60)%60,seconds%60)
    return days > 0 and (days .. "d " .. text) or text
end
function Core.decode64(data)
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup, out, acc, bits = {}, {}, 0, 0
    for i=1,#chars do lookup[chars:sub(i,i)] = i-1 end
    for i=1,#data do
        local value = lookup[data:sub(i,i)]
        if value then
            acc = acc * 64 + value; bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                out[#out+1] = string.char(math.floor(acc / 2^bits) % 256)
                acc = acc % 2^bits
            end
        end
    end
    return table.concat(out)
end
