-- Busqueda paginada. La API se consulta con 100 y luego 50, nunca limit=150.
local function fetchServers(token,isolated)
    local cursor=nil
    local cursorSeen,ids,out={},{},{}
    local scanned=0
    for page=1,8 do
        if not running(token) then return nil,"Cancelado" end
        local delay=math.max(0,S.apiUntil-os.clock())
        if delay>0 then
            status("Roblox limita las peticiones. Esperando "..math.ceil(delay).." s...",C.amber)
            if not pause(delay,token) then return nil,"Cancelado" end
        end
        local limit=(CONFIG.MaxServers-scanned)>=100 and 100 or 50
        local url="https://games.roblox.com/v1/games/"..tostring(game.PlaceId).."/servers/Public?sortOrder=Asc&excludeFullGames=true&limit="..limit
        if cursor then url=url.."&cursor="..Http:UrlEncode(cursor) end
        status(string.format("%s: %d/150 revisados. Pagina %d...",isolated and "ADMINABUSE" or "Buscando",scanned,page))
        local data,err,code,headers
        for retry=1,3 do
            if not running(token) then return nil,"Cancelado" end
            data,err,code,headers=requestJSON({Url=url,Method="GET"},token)
            if data then break end
            if code~=429 and not (code and code>=500) then break end
            local waitFor=2^retry
            if code==429 then
                for key,value in pairs(headers or {}) do
                    if tostring(key):lower()=="retry-after" then waitFor=math.max(waitFor,tonumber(value) or 0) end
                end
                waitFor=math.max(5,waitFor)
            end
            S.apiUntil=os.clock()+waitFor
            if retry<3 then
                status("HTTP "..code..": reintento en "..math.ceil(waitFor).." s.",C.amber)
                if not pause(waitFor,token) then return nil,"Cancelado" end
            end
        end
        if not data then return nil,err or "No se pudieron leer servidores." end
        if type(data.data)~="table" then return nil,"Roblox no devolvio una lista de servidores." end
        for _,raw in ipairs(data.data) do
            if scanned>=CONFIG.MaxServers then break end
            scanned=scanned+1
            local server=Core.normalize(raw)
            if server and not ids[server.id] then
                if isolated then server.observedAt=os.clock() end
                out[#out+1]=server; ids[server.id]=true
            end
        end
        local nextCursor=data.nextPageCursor
        if scanned>=CONFIG.MaxServers or #data.data==0 or type(nextCursor)~="string" or nextCursor=="" or cursorSeen[nextCursor] then break end
        cursorSeen[nextCursor]=true; cursor=nextCursor
        if not pause(1.2,token) then return nil,"Cancelado" end
    end
    if not running(token) then return nil,"Cancelado" end
    if not isolated then S.cache=out; S.cachedAt=os.time(); saveCache(); refresh() end
    return out,nil,scanned
end
local function finish(token,message,color)
