local function running(token)
    return S.alive and S.auth and (not S.expiry or S.expiry>os.time()) and S.run==token
end
local function pause(seconds,token)
    local finish=os.clock()+seconds
    while S.alive and os.clock()<finish do
        if token and not running(token) then return false end
        task.wait(math.min(0.1,math.max(0,finish-os.clock())))
    end
    return S.alive and (not token or running(token))
end
-- Una solicitud a la vez; timeout logico sin solapar peticiones pendientes.
local function requestJSON(options,token)
    if type(Request)~="function" then return nil,"Tu entorno no ofrece request/http_request." end
    if S.requestPending then return nil,"Todavia hay una peticion HTTP pendiente. Espera un momento." end
    S.requestPending=true
    local box={done=false}
    spawn(function()
        box.ok,box.response=pcall(Request,options)
        box.done=true; S.requestPending=false
    end)
    local deadline=os.clock()+CONFIG.RequestTimeout
    while S.alive and not box.done and os.clock()<deadline do
        if token and not running(token) then return nil,"Cancelado" end
        task.wait(0.1)
    end
    if not S.alive then return nil,"Cerrado" end
    if not box.done then return nil,"Tiempo de espera HTTP agotado; espera antes de reintentar." end
    if not box.ok or type(box.response)~="table" then return nil,"Fallo de conexion HTTP." end
    local response=box.response
    local code=tonumber(response.StatusCode or response.Status or response.status_code)
    if not code then return nil,"El entorno no devolvio un estado HTTP valido." end
    if code<200 or code>=300 then return nil,"HTTP "..code,code,response.Headers or {} end
    local ok,data=pcall(function() return Http:JSONDecode(response.Body or response.body or "") end)
    if not ok or type(data)~="table" then return nil,"La respuesta no contiene JSON valido.",code end
    return data,nil,code,response.Headers or {}
end
local function form(fields)
    local list={}
    for k,v in pairs(fields) do list[#list+1]=Http:UrlEncode(k).."="..Http:UrlEncode(tostring(v)) end
    table.sort(list)
    return table.concat(list,"&")
end
local function authRequest(fields)
    fields.name=CONFIG.KeyAuthName; fields.ownerid=CONFIG.KeyAuthOwnerID
    return requestJSON({Url=CONFIG.KeyAuthURL,Method="POST",
        Headers={["Content-Type"]="application/x-www-form-urlencoded"},Body=form(fields)})
end
local function verifyKey(key)
    if not S.session then
        local data,err=authRequest({type="init",ver=CONFIG.KeyAuthVersion})
        if not data then return false,err end
        if data.success~=true then return false,"KeyAuth: "..tostring(data.message or "Inicializacion rechazada") end
        if type(data.sessionid)~="string" or data.sessionid=="" then return false,"KeyAuth no devolvio sesion." end
        S.session=data.sessionid
    end
    local ok,hwid=pcall(function() return game:GetService("RbxAnalyticsService"):GetClientId() end)
    if not ok or type(hwid)~="string" or hwid=="" then return false,"No se pudo obtener el ClientId de este dispositivo." end
    local data,err=authRequest({type="license",key=key,hwid=hwid,sessionid=S.session})
    if not data then return false,err end
    if data.success~=true then
        local msg=tostring(data.message or "Llave rechazada")
        if msg:lower():find("session",1,true) then S.session=nil end
        return false,"KeyAuth: "..msg
    end
    local expiry=nil
    local subscriptions=type(data.info)=="table" and data.info.subscriptions
    if type(subscriptions)=="table" then
        for _,subscription in pairs(subscriptions) do
            if type(subscription)=="table" then
                local n=tonumber(subscription.expiry)
                if Core.number(n) and n>0 then expiry=math.max(expiry or 0,n) end
            end
        end
    end
    if expiry and expiry<=os.time() then return false,"La licencia esta vencida." end
    return true,"Llave validada.",expiry
end
local function login(key)
    if S.authBusy or S.auth then return end
    key=key:match("^%s*(.-)%s*$")
    if key=="" then U.loginStatus.Text="Pega una llave antes de verificar."; return end
    S.authBusy=true; U.verify.Text="CONECTANDO..."; U.loginStatus.Text="Verificando con KeyAuth..."
    spawn(function()
        local success,good,message,expiry=pcall(verifyKey,key)
        if not S.alive then return end
        S.authBusy=false; U.verify.Text="VERIFICAR LLAVE"
        if not success then U.loginStatus.Text="Error interno verificando. Reintenta."; return end
        U.loginStatus.Text=message or "No se pudo verificar."
        if good then
            S.auth=true; S.expiry=expiry
            S.nextAutoAt=os.clock()+CONFIG.AutoSettleSeconds; S.autoBadSince=nil
            writeText(FILES.key,key); U.key.Text=""
            saveSettings(); saveVisited(); layout(); refresh()
            status(prefs.autoHop and "Autosalto activo: comprobando este servidor..." or "Elige SALTAR NORMAL o ADMINABUSE.",C.green)
        end
    end)
end
