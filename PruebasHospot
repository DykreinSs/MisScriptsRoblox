    status(hadTeleport and "Autosalto OFF. El salto ya enviado puede continuar." or (message or "Autosalto OFF. Busqueda detenida."),C.amber)
end
local function startHop(adminMode,automatic)
    if not S.auth or S.busy then return end
    if S.expiry and S.expiry<=os.time() then status("Licencia vencida.",C.red); return end
    if os.clock()<S.searchUntil then
        if not automatic then status("Espera "..math.ceil(S.searchUntil-os.clock()).." s antes de buscar otra vez.",C.amber) end
        return
    end
    if not automatic then
        prefs.autoMode=adminMode and "admin" or "normal"; saveSettings()
    end
    S.nextAutoAt=os.clock()+CONFIG.AutoRetrySeconds; S.autoHasStatus=false
    S.searchUntil=os.clock()+CONFIG.SearchCooldown
    S.run=S.run+1; S.busy=true; S.adminMode=adminMode; refresh()
    local token=S.run
    spawn(function()
        local ok=pcall(runHop,token,adminMode)
        if not ok then finish(token,"Error inesperado durante la busqueda. Puedes reintentar.",C.red) end
    end)
end
