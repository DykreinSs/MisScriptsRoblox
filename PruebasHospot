local function runHop(token,adminMode)
    local pool={}
    local fetched=false
    -- La ruta normal conserva ranking y cache de V5.1.
    if not adminMode then
        pool=candidates()
        if #pool==0 then
            local data,err=fetchServers(token)
            fetched=true
            if not data then finish(token,err,C.red); return end
            pool=candidates()
        end
        if not running(token) then return end
        if #pool==0 then
            finish(token,"No hay coincidencias entre los servidores revisados. Prueba otro filtro o busca despues.",C.amber)
            return
        end
    end
    local maxAttempts=adminMode and CONFIG.AdminMaxAttempts or CONFIG.MaxTeleportAttempts
    for attemptNumber=1,maxAttempts do
        if not running(token) then return end
        if adminMode then
            -- Desincronizar antes de consultar, nunca envejecer la lista despues de elegir.
            status("ADMINABUSE: consulta nueva, 0-1 jugadores y eleccion aleatoria.",C.cyan)
            if not pause(AdminRandom:NextNumber(0.35,1.25),token) then return end
            local data,err=fetchServers(token,true)
            if not data then finish(token,err,C.red); return end
            if not running(token) then return end
            pool=Core.adminCandidates(data,prefs.ping,game.JobId,S.visited,os.time(),
                CONFIG.VisitedTTL,os.clock(),CONFIG.AdminFreshSeconds)
            if #pool==0 then
                finish(token,"ADMINABUSE: sin candidatos 0-1 recientes con tu filtro de ping. No se usara cache vieja.",C.amber)
                return
            end
        else
            pool=candidates()
            if #pool==0 and not fetched then
                local data,err=fetchServers(token); fetched=true
                if not data then finish(token,err,C.red); return end
                pool=candidates()
            end
            if #pool==0 then finish(token,"Se agotaron las coincidencias. Cambia un filtro o busca despues.",C.amber); return end
        end
        local target=adminMode and Core.pickAdmin(pool,prefs.ping,AdminRandom:NextNumber()) or pool[1]
        -- Ambos saltos comparten historial de visitas para no regresar a lo ya intentado.
        S.visited[target.id]=os.time(); saveVisited()
        if not adminMode then
            for i=#S.cache,1,-1 do if S.cache[i].id==target.id then table.remove(S.cache,i) end end
            saveCache()
        end
        saveSettings()
        queueAutoResume()
        local attempt={id=target.id,failed=false,committed=false,message=nil}
        S.attempt=attempt; refresh()
        local advertised=target.ping and (math.floor(target.ping).." ms") or "N/D"
        if adminMode then
            status(string.format("ADMIN %d/%d: %d jugador(es), %s. %d opcion(es); sin reserva de cupo.",
                attemptNumber,maxAttempts,target.playing,advertised,#pool),C.cyan)
        else
            status(string.format("Intento %d/%d: %d jugador(es), ping anunciado %s.",attemptNumber,maxAttempts,target.playing,advertised),C.cyan)
        end
        local ok=pcall(function() Teleport:TeleportToPlaceInstance(game.PlaceId,target.id,Player) end)
        if not ok then attempt.failed=true; attempt.message="Roblox rechazo iniciar el salto." end
        local deadline=os.clock()+25
        while running(token) and not attempt.failed and os.clock()<deadline do task.wait(0.1) end
        if not running(token) then return end
        if not attempt.failed then
            prefs.autoHop=false; saveSettings()
            finish(token,"Roblox no confirmo el resultado. Si sigues aqui, puedes volver a buscar.",C.amber)
            return
        end
        S.attempt=nil
        if attemptNumber<maxAttempts then
            local waitFor=adminMode and AdminRandom:NextNumber(2,3) or 2
            status((attempt.message or "No se pudo entrar.").." Probando otro...",C.amber)
            if not pause(waitFor,token) then return end
        end
    end
    finish(token,"No se pudo entrar tras "..maxAttempts.." intentos. Espera y vuelve a buscar.",C.red)
end
