local function readText(path)
    if type(readfile) ~= "function" then return nil end
    local ok, data = pcall(readfile, path)
    return ok and type(data) == "string" and data or nil
end
local function readJSON(path)
    local data = readText(path)
    if not data then return nil end
    local ok, result = pcall(function() return Http:JSONDecode(data) end)
    return ok and type(result) == "table" and result or nil
end
local function writeText(path, text)
    if type(writefile) ~= "function" then S.storageOK=false; return false end
    local ok = pcall(writefile, path, text)
    if not ok then S.storageOK=false; S.storageError=true end
    return ok
end
